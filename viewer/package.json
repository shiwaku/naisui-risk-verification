{
  "name": "naisui-risk-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "水害履歴(浸水実績)・地形分類・Mapterhorn 地形を重ねて内水氾濫リスクの推定を確かめる Web ビューワ",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:style && npm run check:search && npm run check:relief && npm run check:stacking && npm run export:style && vite build",
    "preview": "vite preview",
    "check:style": "node scripts/check-style.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:relief": "node scripts/check-relief.mjs",
    "check:stacking": "node scripts/check-stacking.mjs",
    "export:style": "node scripts/export-style.mjs"
  },
  "dependencies": {
    "geojson-vt": "^5.0.2",
    "maplibre-contour": "0.0.5",
    "maplibre-gl": "5.6.0",
    "pmtiles": "4.3.0",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^23.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
